# Copy to configs/local.env and edit. Source this file from the release root.
# Complete local model bundles; see docs/ENVIRONMENT.md.
export MOLMO_MODEL_PATH="/path/to/Molmo-7B-D-0924"
export OMNIPARSER_DETECT_PATH="/path/to/OmniParser-v2.0/icon_detect/model.pt"
export OMNIPARSER_CAPTION_PATH="/path/to/complete-florence-caption-bundle"
# Optional separate processor bundle. Normally omit for a complete caption bundle.
# export FLORENCE_PROCESSOR_PATH="/path/to/Florence-2-base"

export POINT_GPU="0"
export OMNIPARSER_GPU="1"
export CRITIC_GPUS="2"
export UI_TOOL_HOST="127.0.0.1"
export UI_TOOL_CONTROLLER_PORT="20001"
export POINT_PORT="20027"
export OMNIPARSER_PORT="20030"
export ZOOM_PORT="20039"
export GUIPRA_TOOL_CONTROLLER_ADDR="http://127.0.0.1:20001"

# Criteria selection, tool routing, and observation filtering use this API.
export GUIPRA_VLLM_BASE_URL="http://127.0.0.1:6008/v1"
export GUIPRA_ROUTER_MODEL="qwen3-vl-8b-instruct"
export GUIPRA_VLLM_TIMEOUT="120"
export GUIPRA_TOOL_TIMEOUT="120"
# 1 matches the supplied benchmark source; 4 matches the paper's stated upper bound.
# Changing this alone does not establish exact paper reproduction.
export GUIPRA_MAX_ROUNDS="1"
export GUIPRA_STRICT_API="1"

# Crop localization uses Qwen3-VL normalized coordinates 0..999.
export ZOOM_API_URL="http://127.0.0.1:8008/v1/chat/completions"
export ZOOM_MODEL_NAME="qwen3-vl-32b-instruct"
export ZOOM_API_TIMEOUT="120"
# Set secrets in your shell if the corresponding API requires them:
# GUIPRA_API_KEY, ZOOM_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY.
# OPENAI_BASE_URL is used only for the critic backend 'oai'.

export OS_CRITIC_DATA_ROOT="/path/to/OS-Critic-Bench"
export NO_PROXY="${NO_PROXY:+${NO_PROXY},}localhost,127.0.0.1"
export no_proxy="${no_proxy:+${no_proxy},}localhost,127.0.0.1"
# Paddle OCR runs on CPU. Point these to existing extracted inference models
# to avoid PaddleOCR's default first-run download into its own cache.
# export PADDLEOCR_DET_MODEL_DIR="/path/to/en_PP-OCRv3_det_infer"
# export PADDLEOCR_REC_MODEL_DIR="/path/to/en_PP-OCRv4_rec_infer"
# export PADDLEOCR_CLS_MODEL_DIR="/path/to/ch_ppocr_mobile_v2.0_cls_infer"
